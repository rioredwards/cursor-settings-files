  ],
  "projectManager.groupList": true,
  "projectManager.sortList": "Recent",
  "projectManager.tags": [
    "Next.js",
    "React.js",
    "Frontend",
    "Backend",
    "Reference",
    "Tutorial",
    "Project"
  ],
  "cmake.configureOnOpen": false,
  "editor.fontSize": 14,
  "githubPullRequests.pullBranch": "never",
  "window.zoomLevel": 1,
  "workbench.editor.tabActionLocation": "left",
  "accessibility.signals.noInlayHints": {
    "sound": "off"
  },
  "html-to-css-autocompletion.autocompletionFilesScope": "workspace",
  "workbench.activityBar.location": "default",
  "cSpell.showCommandsInEditorContextMenu": false,
  "prisma.showPrismaDataPlatformNotification": false,
  "gitlens.codeLens.enabled": false,
  "scm.experimental.showHistoryGraph": true,
  "reactSnippets.settings.importReactOnTop": false,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "workbench.panel.showLabels": false,
  "typescript.experimental.updateImportsOnPaste": true,
  "javascript.experimental.updateImportsOnPaste": true,
  "terminal.integrated.env.osx": {},
  "console-ninja.featureSet": "Community",
  "htmltagwrap.tag": "div",
  "jest.runMode": "deferred",
  "typescript.suggest.paths": false,
  "javascript.suggest.paths": false,
  "editor.codeActionsOnSave": {
    "source.removeUnusedImports": "explicit",
    "source.organizeImports": "explicit"
  },
  "editor.pasteAs.preferences": [
    "text.updateImports"
  ],
  "terminal.integrated.fontLigatures": true,
  "applescript.alwaysShowOutput": true,
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "editor.accessibilitySupport": "off",
  "git.autofetch": true,
  "tailwind-fold.autoFold": true,
  "cursor.cpp.disabledLanguages": ["scminput", "yaml"],
  "lldb.library": "/Applications/Xcode.app/Contents/SharedFrameworks/LLDB.framework/Versions/A/LLDB",
  "lldb.launch.expressions": "native",
  "gitlens.views.scm.grouped.views": {
    "commits": true,
    "branches": true,
    "remotes": true,
    "stashes": true,
    "tags": true,
    "worktrees": true,
    "contributors": true,
    "repositories": false,
    "searchAndCompare": true,
    "launchpad": false
  },
  "workbench.colorTheme": "Gruvbox Material Dark",
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "geminicodeassist.displayInlineContextHint": false,
  "workbench.activityBar.orientation": "vertical",
  "git.confirmSync": false,
  "githubPullRequests.commentExpandState": "collapseAll",
  "workbench.tree.renderIndentGuides": "always",
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.excludeDirty": true,
  "workbench.editor.limit.perEditorGroup": true,
  "workbench.editor.limit.value": 8,
  "workbench.editor.pinnedTabSizing": "shrink",
  "workbench.editor.preventPinnedEditorClose": "never",
  "workbench.editor.revealIfOpen": true,
  "workbench.editor.tabSizing": "shrink"
}
